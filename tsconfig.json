{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node", "mocha"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "ts-node": {
    "experimentalResolver": true,
    "compilerOptions": {
      "noEmit": false,
      "module": "commonjs"
    }
  }
}
